<resources>
    <color name="inbo_mint">#B8EAC8</color>
    <color name="inbo_forest">#163C30</color>
    <color name="inbo_apricot">#FFC477</color>
    <color name="inbo_paper">#F6F7F2</color>
    <color name="inbo_ink">#171C19</color>
    <color name="inbo_window_background">@color/inbo_paper</color>
    <color name="ic_launcher_background">@color/inbo_forest</color>

    <!-- Fixed semantic amount colors (light variant). Deliberately outside
         the Material dynamic palette: debit must always read red, credit
         green and balance blue regardless of wallpaper. Dark variants live
         in values-night/colors.xml; the Compose copies are in
         ui/theme/SemanticAmountColors.kt (kept identical by a unit test). -->
    <color name="amount_debit">#FFB3261E</color>
    <color name="amount_credit">#FF1B5E20</color>
    <color name="amount_balance">#FF0D47A1</color>

    <!-- Notification amount colors: a SINGLE mid-tone per kind, identical in
         light and dark, chosen to stay legible on both the light and dark
         notification shade (bold ~16sp clears WCAG AA large-text 3:1 on both).
         The in-app transactions screen keeps its own theme-adaptive palette
         (ui/theme/SemanticAmountColors.kt); these are only for the shade. -->
    <color name="notif_amount_debit">#FFE53935</color>
    <color name="notif_amount_credit">#FF43A047</color>
    <color name="notif_amount_balance">#FF1E88E5</color>
</resources>
